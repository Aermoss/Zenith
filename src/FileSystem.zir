#[include "src/Memory.zir", "src/Strings.zir", "src/Trap.zir", "src/Process.zir", "src/Flash.zir" : *]

const FILE_SYSTEM_OFFSET: u32 = 0x200000;
const FILE_SYSTEM_START: u32 = FLASH_START + FILE_SYSTEM_OFFSET;
const FILE_SYSTEM_MAGIC: u32 = 0x53464E5A;
const FILE_SYSTEM_VERSION: u32 = 4;
const BLOCK_SIZE: u32 = 4096;
const TABLE_BLOCKS: u32 = 8;
const TABLE_PAGE: u32 = 256;
const MAX_BLOCKS: u32 = (FLASH_WRITABLE_END - FILE_SYSTEM_OFFSET) / BLOCK_SIZE;
const DEFAULT_BLOCKS: u32 = 256;

const TABLE_HEADER_SIZE: u32 = 32;
const FILE_ENTRY_SIZE: u32 = 64;
const FILE_NAME_LENGTH: u32 = 32;
const MAX_FILES: u32 = 63;
const TABLE_SIZE: u32 = TABLE_HEADER_SIZE + MAX_FILES * FILE_ENTRY_SIZE;
const CHECKSUM_SEED: u32 = 0x5A5A5A5A;

const ROOT_DIRECTORY: u32 = 0;
const FILE_DIRECTORY: u32 = 1;

const ROOT_ENTRY: u32 = 0xFFFFFFFE;
const NO_ENTRY: u32 = 0xFFFFFFFF;

const FILE_OK: u32 = 0;
const FILE_NO_FILE_SYSTEM: u32 = 1;
const FILE_NOT_FOUND: u32 = 2;
const FILE_BAD_NAME: u32 = 3;
const FILE_TABLE_FULL: u32 = 4;
const FILE_NO_SPACE: u32 = 5;
const FILE_WRITE_FAILED: u32 = 6;
const FILE_NOT_DIRECTORY: u32 = 7;
const FILE_IS_DIRECTORY: u32 = 8;
const FILE_NOT_EMPTY: u32 = 9;
const FILE_EXISTS: u32 = 10;
const FILE_INTO_ITSELF: u32 = 11;
const FILE_NO_MEMORY: u32 = 12;

class TableHeader {
    pub magic: u32,
    pub version: u32,
    pub sequence: u32,
    pub count: u32,
    pub block_count: u32,
    pub checksum: u32,
    pub next_id: u32,
    pub next_block: u32
}

class FileEntry {
    pub name: [i8; 32],
    pub first_block: u32,
    pub size: u32,
    pub id: u32,
    pub parent: u32,
    pub flags: u32,
    pub reserved0: u32,
    pub reserved1: u32,
    pub reserved2: u32
}

static mut file_table: *mut u8 = null;
static mut current_table: u32 = 0;
static mut current_offset: u32 = 0;
static mut table_end: u32 = 0;
static mut file_system_ready: bool = false;
static mut file_system_locked: bool = false;
static mut used_blocks: [u8; 192];

static mut current_directory: u32 = 0;

fn Table() -> *mut TableHeader {
    file_table as *mut TableHeader
}

fn GetFile(index: u32) -> *mut FileEntry {
    (file_table + (TABLE_HEADER_SIZE + index * FILE_ENTRY_SIZE) as usize) as *mut FileEntry
}

fn FileName(file: *FileEntry) -> *i8 {
    &file->name[0] as *i8
}

fn IsDirectory(file: *FileEntry) -> bool {
    (file->flags & FILE_DIRECTORY) != 0
}

fn BlockCount(size: u32) -> u32 {
    (size + BLOCK_SIZE - 1) / BLOCK_SIZE
}

fn BlockOffset(block: u32) -> u32 {
    FILE_SYSTEM_OFFSET + block * BLOCK_SIZE
}

fn StringLength(mut text: *i8) -> u32 {
    let mut length: u32 = 0;

    while *text != '\0' {
        text += 1;
        length += 1;
    }

    length
}

fn TableChecksum(table: *u8, count: u32) -> u32 {
    let words = table as *u32;
    let length = (TABLE_HEADER_SIZE + count * FILE_ENTRY_SIZE) / 4;
    let mut sum = CHECKSUM_SEED;
    let mut i: u32 = 0;

    while i < length {
        let word = if i == 5 { 0 } else { words[i as usize] };
        sum = ((sum << 5) | (sum >> 27)) ^ word;
        i += 1;
    }

    sum
}

fn CopyFromFlash(offset: u32, destination: *mut u8, count: u32) {
    let source = (FLASH_START + offset) as *u32;
    let words = destination as *mut u32;
    let mut i: u32 = 0;

    while i < count / 4 {
        words[i as usize] = source[i as usize];
        i += 1;
    }
}

fn IsValidTable(table: *u8) -> bool {
    let header = table as *TableHeader;

    header->magic == FILE_SYSTEM_MAGIC && header->version == FILE_SYSTEM_VERSION && header->count <= MAX_FILES &&
        header->block_count > TABLE_BLOCKS && header->block_count <= MAX_BLOCKS && header->checksum == TableChecksum(table, header->count)
}

fn TableLength(count: u32) -> u32 {
    TABLE_HEADER_SIZE + count * FILE_ENTRY_SIZE
}

fn TableSpace(count: u32) -> u32 {
    (TableLength(count) + TABLE_PAGE - 1) / TABLE_PAGE * TABLE_PAGE
}

fn ReadTableAt(offset: u32) -> bool {
    let header = (FLASH_START + offset) as *TableHeader;

    if header->magic != FILE_SYSTEM_MAGIC || header->version != FILE_SYSTEM_VERSION || header->count > MAX_FILES {
        return false;
    }

    CopyFromFlash(offset, file_table, TableLength(header->count));
    IsValidTable(file_table as *u8)
}

fn IsErased(offset: u32, length: u32) -> bool {
    let words = (FLASH_START + offset) as *u32;
    let mut i: u32 = 0;

    while i < length / 4 {
        if words[i as usize] != 0xFFFFFFFF {
            return false;
        }

        i += 1;
    }

    true
}

fn InitializeFileSystem() {
    file_table = Allocate(TABLE_SIZE);
    file_system_ready = false;
    current_directory = ROOT_DIRECTORY;

    let mut block: u32 = 0;
    let mut best_sequence: u32 = 0;

    while block < TABLE_BLOCKS {
        let mut offset: u32 = 0;

        while offset < BLOCK_SIZE && ReadTableAt(BlockOffset(block) + offset) {
            let (sequence, space) = (Table()->sequence, TableSpace(Table()->count));

            if !file_system_ready || ((sequence - best_sequence) as i32) > 0 {
                (best_sequence, current_table, current_offset, table_end) = (sequence, block, offset, offset + space);
                file_system_ready = true;
            }

            offset += space;
        }

        block += 1;
    }

    if file_system_ready {
        ReadTableAt(BlockOffset(current_table) + current_offset);

        if !IsErased(BlockOffset(current_table) + table_end, BLOCK_SIZE - table_end) {
            table_end = BLOCK_SIZE;
        }
    }
}

fn HasFileSystem() -> bool {
    file_system_ready
}

fn LockFileSystem() {
    loop {
        let interrupts = DisableInterrupts();

        if !file_system_locked {
            file_system_locked = true;
            RestoreInterrupts(interrupts);
            return;
        }

        RestoreInterrupts(interrupts);
        Yield();
    }
}

fn UnlockFileSystem() {
    file_system_locked = false;
}

fn FileCount() -> u32 {
    if file_system_ready { Table()->count } else { 0 }
}

fn FileSystemBlocks() -> u32 {
    if file_system_ready { Table()->block_count } else { 0 }
}

fn UsedBlockCount() -> u32 {
    let count = FileCount();
    let mut used = TABLE_BLOCKS;
    let mut i: u32 = 0;

    while i < count {
        used += BlockCount(GetFile(i)->size);
        i += 1;
    }

    used
}

fn IndexOfId(id: u32) -> u32 {
    if id == ROOT_DIRECTORY {
        return ROOT_ENTRY;
    }

    let count = FileCount();
    let mut i: u32 = 0;

    while i < count {
        if GetFile(i)->id == id {
            return i;
        }

        i += 1;
    }

    NO_ENTRY
}

fn IdOfIndex(index: u32) -> u32 {
    if index == ROOT_ENTRY { ROOT_DIRECTORY } else { GetFile(index)->id }
}

fn IsDirectoryIndex(index: u32) -> bool {
    index == ROOT_ENTRY || (index != NO_ENTRY && IsDirectory(GetFile(index) as *FileEntry))
}

fn ParentOf(index: u32) -> u32 {
    if index == ROOT_ENTRY { ROOT_DIRECTORY } else { GetFile(index)->parent }
}

fn FindChild(directory: u32, name: *i8) -> u32 {
    let count = FileCount();
    let mut i: u32 = 0;

    while i < count {
        let file = GetFile(i);

        if file->parent == directory && Equals(FileName(file as *FileEntry), name) {
            return i;
        }

        i += 1;
    }

    NO_ENTRY
}

fn HasChildren(directory: u32) -> bool {
    let count = FileCount();
    let mut i: u32 = 0;

    while i < count {
        if GetFile(i)->parent == directory {
            return true;
        }

        i += 1;
    }

    false
}

fn ResolvePath(path: *i8, length: u32) -> u32 {
    let mut index = if length > 0 && *path == '/' { ROOT_ENTRY } else { IndexOfId(current_directory) };
    let mut component: [i8; 32];
    let mut i: u32 = 0;

    while i < length {
        if *(path + i as usize) == '/' {
            i += 1;
            continue;
        }

        let mut n: u32 = 0;

        while i < length && *(path + i as usize) != '/' {
            if n + 1 >= FILE_NAME_LENGTH {
                return NO_ENTRY;
            }

            component[n as usize] = *(path + i as usize);
            n += 1;
            i += 1;
        }

        component[n as usize] = '\0';

        if !IsDirectoryIndex(index) {
            return NO_ENTRY;
        }

        if Equals(&component[0] as *i8, "..") {
            index = IndexOfId(ParentOf(index));
        } else if !Equals(&component[0] as *i8, ".") {
            index = FindChild(IdOfIndex(index), &component[0] as *i8);

            if index == NO_ENTRY {
                return NO_ENTRY;
            }
        }
    }

    index
}

fn FindPath(path: *i8) -> u32 {
    ResolvePath(path, StringLength(path))
}

fn FindFile(path: *i8) -> *FileEntry {
    if !file_system_ready {
        return null;
    }

    let index = FindPath(path);
    if index == NO_ENTRY || index == ROOT_ENTRY { null } else { GetFile(index) as *FileEntry }
}

fn IsValidName(mut name: *i8) -> bool {
    let mut length: u32 = 0;

    while *name != '\0' {
        if *name == ' ' || *name == '/' {
            return false;
        }

        name += 1;
        length += 1;
    }

    length > 0 && length < FILE_NAME_LENGTH
}

fn SplitPath(path: *i8, name: *mut i8) -> u32 {
    let mut length = StringLength(path);

    while length > 1 && *(path + (length - 1) as usize) == '/' {
        length -= 1;
    }

    let mut start = length;

    while start > 0 && *(path + (start - 1) as usize) != '/' {
        start -= 1;
    }

    if length - start == 0 || length - start >= FILE_NAME_LENGTH {
        *name = '\0';
        return NO_ENTRY;
    }

    let mut i: u32 = 0;

    while start + i < length {
        name[i as usize] = *(path + (start + i) as usize);
        i += 1;
    }

    name[i as usize] = '\0';
    let directory = ResolvePath(path, start);
    if IsDirectoryIndex(directory) { directory } else { NO_ENTRY }
}

fn CopyName(destination: *mut i8, mut name: *i8) {
    let mut i: u32 = 0;

    while i < FILE_NAME_LENGTH {
        destination[i as usize] = *name;

        if *name != '\0' {
            name += 1;
        }

        i += 1;
    }
}

fn AddEntry(name: *i8, parent: u32, flags: u32) -> u32 {
    let table = Table();
    let index = table->count;
    let file = GetFile(index);
    CopyName(&mut file->name[0], name);
    (file->first_block, file->size, file->id, file->parent, file->flags) = (0, 0, table->next_id, parent, flags);
    (file->reserved0, file->reserved1, file->reserved2) = (0, 0, 0);
    table->next_id += 1;
    table->count += 1;
    index
}

fn RemoveEntry(index: u32) {
    let count = Table()->count;
    let mut i = index;

    while i + 1 < count {
        let (destination, source) = (GetFile(i) as *mut u8, GetFile(i + 1) as *u8);
        let mut j: u32 = 0;

        while j < FILE_ENTRY_SIZE {
            destination[j as usize] = source[j as usize];
            j += 1;
        }

        i += 1;
    }

    Table()->count = count - 1;
}

fn ReadFileData(file: *FileEntry, offset: u32, buffer: *mut u8, count: u32) -> u32 {
    if offset >= file->size {
        return 0;
    }

    let length = if count < file->size - offset { count } else { file->size - offset };
    let start = FILE_SYSTEM_START + file->first_block * BLOCK_SIZE + offset;
    let mut word: u32 = 0;
    let mut i: u32 = 0;

    while i < length {
        let address = start + i;

        if i == 0 || (address & 3) == 0 {
            word = *((address & 0xFFFFFFFC) as *u32);
        }

        buffer[i as usize] = ((word >> ((address & 3) * 8)) & 0xFF) as u8;
        i += 1;
    }

    length
}

fn ReadFile(file: *FileEntry, offset: u32, buffer: *mut u8, count: u32) -> u32 {
    LockFileSystem();
    let length = ReadFileData(file, offset, buffer, count);
    UnlockFileSystem();
    length
}

fn MarkBlocks(first: u32, count: u32) {
    let mut block = first;

    while block < first + count {
        used_blocks[(block / 8) as usize] |= (1 << (block % 8)) as u8;
        block += 1;
    }
}

fn IsBlockUsed(block: u32) -> bool {
    (used_blocks[(block / 8) as usize] & (1 << (block % 8)) as u8) != 0
}

fn FindRun(from: u32, to: u32, count: u32) -> u32 {
    let mut start = from;
    let mut run: u32 = 0;
    let mut block = from;

    while block < to && run < count {
        if IsBlockUsed(block) {
            run = 0;
            start = block + 1;
        } else {
            run += 1;
        }

        block += 1;
    }

    if run == count { start } else { 0 }
}

fn FindFreeBlocks(count: u32) -> u32 {
    let total = FileSystemBlocks();
    let mut i: u32 = 0;

    while i < 192 {
        used_blocks[i as usize] = 0;
        i += 1;
    }

    MarkBlocks(0, TABLE_BLOCKS);
    i = 0;

    while i < FileCount() {
        let file = GetFile(i);
        MarkBlocks(file->first_block, BlockCount(file->size));
        i += 1;
    }

    let mut hint = Table()->next_block;

    if hint < TABLE_BLOCKS || hint >= total {
        hint = TABLE_BLOCKS;
    }

    let first = FindRun(hint, total, count);
    if first != 0 { first } else { FindRun(TABLE_BLOCKS, total, count) }
}

fn MatchesFlash(offset: u32, data: *u8, count: u32) -> bool {
    let flash = (FLASH_START + offset) as *u8;
    let mut i: u32 = 0;

    while i < count {
        if flash[i as usize] != data[i as usize] {
            return false;
        }

        i += 1;
    }

    true
}

fn CommitTable() -> bool {
    let table = Table();
    table->sequence += 1;
    table->checksum = TableChecksum(file_table as *u8, table->count);
    let (length, space) = (TableLength(table->count), TableSpace(table->count));
    let (mut block, mut offset) = (current_table, table_end);

    if offset + space > BLOCK_SIZE {
        (block, offset) = ((current_table + 1) % TABLE_BLOCKS, 0);

        if !EraseFlashSector(BlockOffset(block)) {
            return false;
        }
    }

    let address = BlockOffset(block) + offset;

    if !ProgramFlash(address, file_table as *u8, length) || !MatchesFlash(address, file_table as *u8, length) {
        if block == current_table {
            table_end = BLOCK_SIZE;
        }

        return false;
    }

    (current_table, current_offset, table_end) = (block, offset, offset + space);
    true
}

fn RestoreTable() {
    ReadTableAt(BlockOffset(current_table) + current_offset);
}

fn CommitOrRestore() -> u32 {
    if CommitTable() {
        return FILE_OK;
    }

    RestoreTable();
    FILE_WRITE_FAILED
}

fn WriteFileIn(directory: u32, name: *i8, data: *u8, size: u32) -> u32 {
    if !IsValidName(name) {
        return FILE_BAD_NAME;
    }

    let parent = IdOfIndex(directory);
    let mut index = FindChild(parent, name);

    if index != NO_ENTRY && IsDirectory(GetFile(index) as *FileEntry) {
        return FILE_IS_DIRECTORY;
    }

    if index == NO_ENTRY && FileCount() == MAX_FILES {
        return FILE_TABLE_FULL;
    }

    let blocks = BlockCount(size);
    let first = if blocks == 0 { 0 } else { FindFreeBlocks(blocks) };

    if blocks > 0 && first == 0 {
        return FILE_NO_SPACE;
    }

    let mut block: u32 = 0;

    while block < blocks {
        if !EraseFlashSector(BlockOffset(first + block)) {
            return FILE_WRITE_FAILED;
        }

        block += 1;
    }

    if size > 0 && (!ProgramFlash(BlockOffset(first), data, size) || !MatchesFlash(BlockOffset(first), data, size)) {
        return FILE_WRITE_FAILED;
    }

    if index == NO_ENTRY {
        index = AddEntry(name, parent, 0);
    }

    let file = GetFile(index);
    (file->first_block, file->size) = (first, size);

    if blocks > 0 {
        Table()->next_block = first + blocks;
    }

    CommitOrRestore()
}

fn WriteFile(path: *i8, data: *u8, size: u32) -> u32 {
    if !file_system_ready {
        return FILE_NO_FILE_SYSTEM;
    }

    LockFileSystem();
    let mut name: [i8; 32];
    let directory = SplitPath(path, &mut name[0]);
    let result = if directory == NO_ENTRY { FILE_NOT_FOUND } else { WriteFileIn(directory, &name[0] as *i8, data, size) };
    UnlockFileSystem();
    result
}

fn MakeDirectory(path: *i8) -> u32 {
    if !file_system_ready {
        return FILE_NO_FILE_SYSTEM;
    }

    LockFileSystem();
    let mut name: [i8; 32];
    let directory = SplitPath(path, &mut name[0]);
    let mut result = FILE_OK;

    if directory == NO_ENTRY {
        result = FILE_NOT_FOUND;
    } else if !IsValidName(&name[0] as *i8) || Equals(&name[0] as *i8, ".") || Equals(&name[0] as *i8, "..") {
        result = FILE_BAD_NAME;
    } else if FindChild(IdOfIndex(directory), &name[0] as *i8) != NO_ENTRY {
        result = FILE_EXISTS;
    } else if FileCount() == MAX_FILES {
        result = FILE_TABLE_FULL;
    } else {
        AddEntry(&name[0] as *i8, IdOfIndex(directory), FILE_DIRECTORY);
        result = CommitOrRestore();
    }

    UnlockFileSystem();
    result
}

fn RemovePath(path: *i8) -> u32 {
    if !file_system_ready {
        return FILE_NO_FILE_SYSTEM;
    }

    LockFileSystem();
    let index = FindPath(path);
    let mut result = FILE_OK;

    if index == NO_ENTRY || index == ROOT_ENTRY {
        result = FILE_NOT_FOUND;
    } else {
        let (id, parent, directory) = (GetFile(index)->id, GetFile(index)->parent, IsDirectory(GetFile(index) as *FileEntry));

        if directory && HasChildren(id) {
            result = FILE_NOT_EMPTY;
        } else {
            RemoveEntry(index);
            result = CommitOrRestore();

            if result == FILE_OK && current_directory == id {
                current_directory = parent;
            }
        }
    }

    UnlockFileSystem();
    result
}

fn FindDestination(destination: *i8, source_name: *i8, name: *mut i8) -> u32 {
    let index = FindPath(destination);

    if IsDirectoryIndex(index) {
        CopyName(name, source_name);
        return index;
    }

    SplitPath(destination, name)
}

fn IsInside(directory: u32, ancestor: u32) -> bool {
    let mut id = directory;

    while id != ROOT_DIRECTORY {
        let index = IndexOfId(id);

        if id == ancestor || index == NO_ENTRY {
            return id == ancestor;
        }

        id = ParentOf(index);
    }

    ancestor == ROOT_DIRECTORY
}

fn MovePath(source: *i8, destination: *i8) -> u32 {
    if !file_system_ready {
        return FILE_NO_FILE_SYSTEM;
    }

    LockFileSystem();
    let index = FindPath(source);
    let mut name: [i8; 32];
    let mut result = FILE_OK;

    if index == NO_ENTRY || index == ROOT_ENTRY {
        UnlockFileSystem();
        return FILE_NOT_FOUND;
    }

    let id = GetFile(index)->id;
    let is_directory = IsDirectory(GetFile(index) as *FileEntry);
    let directory = FindDestination(destination, FileName(GetFile(index) as *FileEntry), &mut name[0]);

    if directory == NO_ENTRY {
        result = FILE_NOT_FOUND;
    } else if !IsValidName(&name[0] as *i8) {
        result = FILE_BAD_NAME;
    } else if is_directory && IsInside(IdOfIndex(directory), id) {
        result = FILE_INTO_ITSELF;
    } else {
        let existing = FindChild(IdOfIndex(directory), &name[0] as *i8);

        if existing != NO_ENTRY && GetFile(existing)->id != id {
            if is_directory || IsDirectory(GetFile(existing) as *FileEntry) {
                result = FILE_EXISTS;
            } else {
                RemoveEntry(existing);
            }
        }

        if result == FILE_OK {
            let file = GetFile(IndexOfId(id));
            CopyName(&mut file->name[0], &name[0] as *i8);
            file->parent = IdOfIndex(directory);
            result = CommitOrRestore();
        }
    }

    UnlockFileSystem();
    result
}

fn CopyFile(source: *i8, destination: *i8) -> u32 {
    if !file_system_ready {
        return FILE_NO_FILE_SYSTEM;
    }

    LockFileSystem();
    let index = FindPath(source);
    let mut name: [i8; 32];
    let mut result = FILE_OK;

    if index == NO_ENTRY || index == ROOT_ENTRY {
        result = FILE_NOT_FOUND;
    } else if IsDirectory(GetFile(index) as *FileEntry) {
        result = FILE_IS_DIRECTORY;
    } else {
        let file = GetFile(index) as *FileEntry;
        let size = file->size;
        let data = Allocate(if size == 0 { 1 } else { size });
        let directory = FindDestination(destination, FileName(file), &mut name[0]);

        if data == null {
            result = FILE_NO_MEMORY;
        } else if directory == NO_ENTRY {
            result = FILE_NOT_FOUND;
        } else {
            ReadFileData(file, 0, data, size);
            result = WriteFileIn(directory, &name[0] as *i8, data as *u8, size);
        }

        if data != null {
            Free(data);
        }
    }

    UnlockFileSystem();
    result
}

fn ChangeDirectory(path: *i8) -> u32 {
    if !file_system_ready {
        return FILE_NO_FILE_SYSTEM;
    }

    let index = FindPath(path);

    if index == NO_ENTRY {
        return FILE_NOT_FOUND;
    }

    if !IsDirectoryIndex(index) {
        return FILE_NOT_DIRECTORY;
    }

    current_directory = IdOfIndex(index);
    FILE_OK
}

fn FormatFileSystem(block_count: u32) -> u32 {
    if file_table == null {
        file_table = Allocate(TABLE_SIZE);
    }

    LockFileSystem();
    let table = Table();
    (table->magic, table->version, table->count, table->block_count) = (FILE_SYSTEM_MAGIC, FILE_SYSTEM_VERSION, 0, block_count);
    (table->sequence, table->next_id, table->next_block) = (0, 1, TABLE_BLOCKS);
    current_directory = ROOT_DIRECTORY;

    let mut erased = true;
    let mut block: u32 = 0;

    while block < TABLE_BLOCKS && erased {
        erased = EraseFlashSector(BlockOffset(block));
        block += 1;
    }

    (current_table, current_offset, table_end) = (0, 0, 0);
    file_system_ready = erased && CommitTable();
    UnlockFileSystem();
    if file_system_ready { FILE_OK } else { FILE_WRITE_FAILED }
}

fn FileErrorMessage(error: u32) -> *i8 {
    if error == FILE_NO_FILE_SYSTEM {
        "There is no file system, format makes one."
    } else if error == FILE_NOT_FOUND {
        "There is no such file or directory."
    } else if error == FILE_BAD_NAME {
        "A name must have 1 to 31 characters without spaces or slashes."
    } else if error == FILE_TABLE_FULL {
        "There is no room for another entry."
    } else if error == FILE_NO_SPACE {
        "There is not enough free space."
    } else if error == FILE_WRITE_FAILED {
        "Writing to the flash failed."
    } else if error == FILE_NOT_DIRECTORY {
        "That is not a directory."
    } else if error == FILE_IS_DIRECTORY {
        "That is a directory."
    } else if error == FILE_NOT_EMPTY {
        "The directory is not empty."
    } else if error == FILE_EXISTS {
        "There is already something with that name."
    } else if error == FILE_INTO_ITSELF {
        "A directory cannot go into itself."
    } else if error == FILE_NO_MEMORY {
        "There is not enough memory."
    } else {
        "The operation succeeded."
    }
}
