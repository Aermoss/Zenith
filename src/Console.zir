#[include "src/Devices.zir", "src/Process.zir", "src/Strings.zir" : *]

const BAUD_RATE: u32 = 115200;

fn WriteCharacter(character: i8) {
    while (*(UART_STATUS as *u32) & 2) != 0 {}
    *(UART_DATA as *mut i8) = character;
}

fn Write(mut string: *i8) {
    while *string != '\0' {
        WriteCharacter(*string);
        string += 1;
    }
}

fn WriteLine(string: *i8) {
    Write(string);
    WriteCharacter('\n');
}

fn WriteInteger(value: u32) {
    if value >= 10 {
        WriteInteger(value / 10);
    }

    WriteCharacter(48 + (value % 10) as i8);
}

fn WriteHexadecimalDigits(value: u32, digits: u32) {
    let mut i = digits;

    while i > 0 {
        i -= 1;
        let nibble = ((value >> (i * 4)) & 0xF) as u8;

        if nibble < 10 {
            WriteCharacter('0' + nibble as i8);
        } else {
            WriteCharacter('A' + (nibble as i8 - 10));
        }
    }
}

fn WriteHexadecimal(value: u32) {
    Write("0x");
    WriteHexadecimalDigits(value, 8);
}

const RECEIVE_BUFFER_SIZE: u32 = 256;

static mut receive_buffer: [i8; 256];
static mut receive_head: u32 = 0;
static mut receive_tail: u32 = 0;

fn ReceiveCharacter() {
    let character = *(UART_DATA as *u32) as i8;
    let next = (receive_head + 1) & (RECEIVE_BUFFER_SIZE - 1);

    if next != receive_tail {
        receive_buffer[receive_head as usize] = character;
        receive_head = next;
    }
}

fn HasCharacter() -> bool {
    receive_head != receive_tail
}

fn ReadCharacter() -> i8 {
    let state = DisableInterrupts();

    while !HasCharacter() {
        WaitForInput();
    }

    RestoreInterrupts(state);
    let character = receive_buffer[receive_tail as usize];
    receive_tail = (receive_tail + 1) & (RECEIVE_BUFFER_SIZE - 1);
    character
}

const KEY_HOME: i8 = '\x01';
const KEY_LEFT: i8 = '\x02';
const KEY_DELETE: i8 = '\x04';
const KEY_END: i8 = '\x05';
const KEY_RIGHT: i8 = '\x06';
const KEY_DOWN: i8 = '\x0E';
const KEY_UP: i8 = '\x10';

fn ReadKey() -> i8 {
    let character = ReadCharacter();

    if character != '\x1B' {
        return character;
    }

    let kind = ReadCharacter();

    if kind != '[' && kind != 'O' {
        return '\0';
    }

    let mut number: u32 = 0;
    let mut first = true;
    let mut code = ReadCharacter();

    while (code >= '0' && code <= '9') || code == ';' {
        if code == ';' {
            first = false;
        } else if first {
            number = number * 10 + (code - '0') as u32;
        }

        code = ReadCharacter();
    }

    if code == 'A' {
        return KEY_UP;
    } else if code == 'B' {
        return KEY_DOWN;
    } else if code == 'C' {
        return KEY_RIGHT;
    } else if code == 'D' {
        return KEY_LEFT;
    } else if code == 'H' || (code == '~' && (number == 1 || number == 7)) {
        return KEY_HOME;
    } else if code == 'F' || (code == '~' && (number == 4 || number == 8)) {
        return KEY_END;
    } else if code == '~' && number == 3 {
        return KEY_DELETE;
    }

    '\0'
}

fn WriteCharacters(buffer: *mut i8, start: usize, end: usize) {
    let mut i = start;

    while i < end {
        WriteCharacter(buffer[i]);
        i += 1;
    }
}

fn MoveCursorLeft(count: usize) {
    let mut i: usize = 0;

    while i < count {
        WriteCharacter('\x08');
        i += 1;
    }
}

fn InsertCharacter(buffer: *mut i8, cursor: usize, count: usize, character: i8) -> usize {
    let mut i = count;

    while i > cursor {
        buffer[i] = buffer[i - 1];
        i -= 1;
    }

    buffer[cursor] = character;
    WriteCharacters(buffer, cursor, count + 1);
    MoveCursorLeft(count - cursor);
    count + 1
}

fn DeleteCharacter(buffer: *mut i8, cursor: usize, count: usize) -> usize {
    let mut i = cursor;

    while i < count - 1 {
        buffer[i] = buffer[i + 1];
        i += 1;
    }

    WriteCharacters(buffer, cursor, count - 1);
    WriteCharacter(' ');
    MoveCursorLeft(count - cursor);
    count - 1
}

const HISTORY_SIZE: u32 = 16;
const HISTORY_LINE_LENGTH: usize = 128;

static mut history: [i8; 2048];
static mut history_count: u32 = 0;
static mut history_next: u32 = 0;
static mut history_draft: [i8; 128];

fn HistorySlot(slot: u32) -> *mut i8 {
    &mut history[slot as usize * HISTORY_LINE_LENGTH]
}

fn HistoryLine(age: u32) -> *i8 {
    HistorySlot((history_next + HISTORY_SIZE - age) % HISTORY_SIZE) as *i8
}

fn CopyLine(destination: *mut i8, mut source: *i8, length: usize) -> usize {
    let mut count: usize = 0;

    while *source != '\0' && count < length - 1 {
        destination[count] = *source;
        source += 1;
        count += 1;
    }

    destination[count] = '\0';
    count
}

fn AddHistory(line: *i8) {
    if *line == '\0' || (history_count > 0 && Equals(line, HistoryLine(1))) {
        return;
    }

    CopyLine(HistorySlot(history_next), line, HISTORY_LINE_LENGTH);
    history_next = (history_next + 1) % HISTORY_SIZE;

    if history_count < HISTORY_SIZE {
        history_count += 1;
    }
}

fn ReplaceLine(buffer: *mut i8, length: usize, cursor: usize, count: usize, text: *i8) -> usize {
    MoveCursorLeft(cursor);
    let new_count = CopyLine(buffer, text, length);
    WriteCharacters(buffer, 0, new_count);
    let mut i = new_count;

    while i < count {
        WriteCharacter(' ');
        i += 1;
    }

    if count > new_count {
        MoveCursorLeft(count - new_count);
    }

    new_count
}

fn ReadLine(buffer: *mut i8, length: usize) -> usize {
    let mut count: usize = 0;
    let mut cursor: usize = 0;
    let mut age: u32 = 0;
    let mut key = ReadKey();

    while key != '\r' && key != '\n' {
        if key == KEY_UP && age < history_count {
            if age == 0 {
                buffer[count] = '\0';
                CopyLine(&mut history_draft[0], buffer as *i8, HISTORY_LINE_LENGTH);
            }

            age += 1;
            count = ReplaceLine(buffer, length, cursor, count, HistoryLine(age));
            cursor = count;
        } else if key == KEY_DOWN && age > 0 {
            age -= 1;
            let text = if age == 0 { &history_draft[0] as *i8 } else { HistoryLine(age) };
            count = ReplaceLine(buffer, length, cursor, count, text);
            cursor = count;
        } else if key == KEY_LEFT && cursor > 0 {
            cursor -= 1;
            WriteCharacter('\x08');
        } else if key == KEY_RIGHT && cursor < count {
            WriteCharacter(buffer[cursor]);
            cursor += 1;
        } else if key == KEY_HOME {
            MoveCursorLeft(cursor);
            cursor = 0;
        } else if key == KEY_END {
            WriteCharacters(buffer, cursor, count);
            cursor = count;
        } else if (key == '\x08' || key == '\x7F') && cursor > 0 {
            cursor -= 1;
            WriteCharacter('\x08');
            count = DeleteCharacter(buffer, cursor, count);
        } else if key == KEY_DELETE && cursor < count {
            count = DeleteCharacter(buffer, cursor, count);
        } else if key >= ' ' && key != '\x7F' && count < length - 1 {
            count = InsertCharacter(buffer, cursor, count, key);
            cursor += 1;
        }

        key = ReadKey();
    }

    WriteCharacter('\n');
    buffer[count] = '\0';
    count
}
