#[include "src/Devices.zir", "src/Console.zir", "src/Memory.zir", "src/Interrupts.zir", "src/Shell.zir" : *]

@track_caller
fn Panic(message: *i8) {
    let (file, row, column) = caller_location();
    Write("Panicked at ");
    Write(file);
    WriteCharacter(':');
    WriteInteger(row);
    WriteCharacter(':');
    WriteInteger(column);
    Write(": ");
    WriteLine(message);
    loop {}
}

@nomangle
fn Main(image_end: u32) {
    SetBaudRate(BAUD_RATE);
    SetLEDs(0x3F);
    InitializeMemory(image_end);
    InitializeInterrupts();
    WriteLine("Zenith kernel started.");
    WriteLine("Type help to see the commands.");
    RunShell();
}
