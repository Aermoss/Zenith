#[include "src/Devices.zir", "src/Console.zir", "src/Strings.zir", "src/Memory.zir", "src/Interrupts.zir", "src/Process.zir", "src/Animation.zir", "src/Programs.zir", "src/FileSystem.zir" : *]

const LINE_LENGTH: usize = 128;
const DUMP_LENGTH: u32 = 64;
const CAT_BUFFER_SIZE: usize = 64;
const COMPILER_STACK_SIZE: u32 = 256 * 1024;

fn CommandHelp() {
    WriteLine("help                     show the commands");
    WriteLine("echo <text>              print the text");
    WriteLine("uptime                   show the time since boot");
    WriteLine("clear                    clear the screen");
    WriteLine("info                     show the memory map");
    WriteLine("peek <address>           read a word");
    WriteLine("poke <address> <value>   write a word");
    WriteLine("dump <address> [length]  show memory as bytes");
    WriteLine("heap                     show how much of the heap is used");
    WriteLine("alloc <size>             allocate memory from the heap");
    WriteLine("free <address>           free memory allocated with alloc");
    WriteLine("anim <mode> [brightness] set the RGB LED animation, 0 to 4");
    WriteLine("ps                       show the processes");
    WriteLine("run <program>            start anim, counter, spin or hello as a process");
    WriteLine("kill <pid>               stop a process");
    WriteLine("ls [path]                show a directory");
    WriteLine("cat <file>               print a file");
    WriteLine("write <file> <text>      write the text into a file");
    WriteLine("mkdir <path>             make a directory");
    WriteLine("cd [path]                go into a directory, or to the root");
    WriteLine("pwd                      show the current directory");
    WriteLine("cp <source> <target>     copy a file");
    WriteLine("mv <source> <target>     move or rename a file or a directory");
    WriteLine("rm <path>                delete a file or an empty directory");
    WriteLine("df                       show how much of the file system is used");
    WriteLine("zircon <input> <output>  compile Zircon to Zodiac assembly");
    WriteLine("format                   make an empty file system, the files are lost");
}

fn WriteRange(name: *i8, start: u32, end: u32) {
    Write(name);
    WriteHexadecimal(start);
    Write(" - ");
    WriteHexadecimal(end);
    WriteCharacter('\n');
}

fn CommandInfo() {
    Write("Clock:    ");
    WriteInteger(CLK_FREQ / 1000000);
    WriteLine(" MHz");
    WriteRange("Stacks:   ", STACKS_START, STACKS_END);
    WriteRange("Kernel:   ", SDRAM_START, kernel_end);
    WriteRange("Heap:     ", heap_start, heap_end);
    WriteRange("Flash:    ", FLASH_START, FLASH_END);
    Write("Flash ID: 0x");
    WriteHexadecimalDigits(ReadFlashId(), 6);
    WriteCharacter('\n');

    if HasFileSystem() {
        WriteRange("Files:    ", FILE_SYSTEM_START, FILE_SYSTEM_START + FileSystemBlocks() * BLOCK_SIZE);
    }
}

fn IsWordAddress(address: u32) -> bool {
    if (address & 3) != 0 {
        WriteLine("The address must be a multiple of 4.");
        return false;
    }

    true
}

fn CommandPeek(arguments: *i8) {
    let mut address: u32 = 0;
    let rest = ParseNumber(arguments, &mut address);

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: peek <address>");
        return;
    }

    if !IsWordAddress(address) {
        return;
    }

    WriteHexadecimal(address);
    Write(": ");
    WriteHexadecimal(*(address as *u32));
    WriteCharacter('\n');
}

fn CommandPoke(arguments: *i8) {
    let mut address: u32 = 0;
    let mut value: u32 = 0;
    let mut rest = ParseNumber(arguments, &mut address);

    if rest != null {
        rest = ParseNumber(rest, &mut value);
    }

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: poke <address> <value>");
        return;
    }

    if !IsWordAddress(address) {
        return;
    }

    *(address as *mut u32) = value;
}

fn CommandDump(arguments: *i8) {
    let mut address: u32 = 0;
    let mut length = DUMP_LENGTH;
    let mut rest = ParseNumber(arguments, &mut address);

    if rest != null && !AtEnd(rest) {
        rest = ParseNumber(rest, &mut length);
    }

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: dump <address> [length]");
        return;
    }

    let end = address + length;
    let mut line = address;

    while line < end {
        WriteHexadecimalDigits(line, 8);
        Write(": ");
        let mut i: u32 = 0;

        while i < 16 {
            if line + i < end {
                WriteHexadecimalDigits(*((line + i) as *u8) as u32, 2);
                WriteCharacter(' ');
            } else {
                Write("   ");
            }

            i += 1;
        }

        Write(" ");
        i = 0;

        while i < 16 && line + i < end {
            let character = *((line + i) as *i8);

            if character >= ' ' && character <= '~' {
                WriteCharacter(character);
            } else {
                WriteCharacter('.');
            }

            i += 1;
        }

        WriteCharacter('\n');
        line += 16;
    }
}

fn CommandHeap() {
    let mut used: u32 = 0;
    let mut free: u32 = 0;
    let mut largest_free: u32 = 0;
    GetHeapStatistics(&mut used, &mut free, &mut largest_free);

    WriteRange("Heap:    ", heap_start, heap_end);
    Write("Used:    ");
    WriteInteger(used);
    WriteLine(" bytes");
    Write("Free:    ");
    WriteInteger(free);
    Write(" bytes, the largest block is ");
    WriteInteger(largest_free);
    WriteLine(" bytes");
}

fn CommandAlloc(arguments: *i8) {
    let mut size: u32 = 0;
    let rest = ParseNumber(arguments, &mut size);

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: alloc <size>");
        return;
    }

    let pointer = Allocate(size);

    if pointer == null {
        WriteLine("Not enough memory.");
        return;
    }

    Write("Allocated ");
    WriteInteger(size);
    Write(" bytes at ");
    WriteHexadecimal(pointer as u32);
    WriteCharacter('\n');
}

fn CommandFree(arguments: *i8) {
    let mut address: u32 = 0;
    let rest = ParseNumber(arguments, &mut address);

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: free <address>");
        return;
    }

    if !Free(address as *mut u8) {
        WriteLine("There is no allocation at that address.");
    }
}

fn CommandAnimation(arguments: *i8) {
    let mut mode: u32 = 0;
    let mut brightness = animation_brightness as u32;
    let mut rest = ParseNumber(arguments, &mut mode);

    if rest != null && !AtEnd(rest) {
        rest = ParseNumber(rest, &mut brightness);
    }

    if rest == null || !AtEnd(rest) || mode >= ANIMATION_MODES || brightness > 255 {
        WriteLine("Usage: anim <mode> [brightness] [speed]");
        return;
    }

    animation_mode = mode;
    animation_brightness = brightness as u8;
}

fn DigitCount(mut value: u32) -> u32 {
    let mut digits: u32 = 1;

    while value >= 10 {
        value /= 10;
        digits += 1;
    }

    digits
}

fn WriteSpaces(count: u32) {
    let mut i: u32 = 0;

    while i < count {
        WriteCharacter(' ');
        i += 1;
    }
}

fn WriteColumn(mut text: *i8, width: u32) {
    let mut length: u32 = 0;

    while *text != '\0' {
        WriteCharacter(*text);
        text += 1;
        length += 1;
    }

    WriteSpaces(width - length);
}

fn WriteIntegerColumn(value: u32, width: u32) {
    WriteInteger(value);
    WriteSpaces(width - DigitCount(value));
}

fn StateName(id: u32) -> *i8 {
    match processes[id as usize].state {
        ProcessState::Free => "free",
        ProcessState::Ready => if id == current_process { "running" } else { "ready" },
        ProcessState::Sleeping => "sleeping",
        ProcessState::Waiting => "waiting",
        ProcessState::Crashed => "crashed"
    }
}

fn CommandProcesses() {
    WriteLine("PID  STATE     TICKS     STACK             NAME");
    let mut id: u32 = 0;

    while id < MAX_PROCESSES {
        let process = &processes[id as usize];

        if process.state != ProcessState::Free {
            WriteIntegerColumn(id, 5);
            WriteColumn(StateName(id), 10);
            WriteIntegerColumn(process.ticks, 10);
            WriteColumn(if IsStackInBRAM(id) { "bram" } else { "sdram" }, 6);
            WriteHexadecimal(process.stack_bottom);
            WriteSpaces(2);
            WriteLine(process.name);
        }

        id += 1;
    }
}

fn CommandRun(arguments: *i8) {
    let mut process = NO_PROCESS;

    if Equals(arguments, "anim") {
        process = Spawn("anim", RunAnimation, 0);
    } else if Equals(arguments, "counter") {
        process = Spawn("counter", RunCounter, 0);
    } else if Equals(arguments, "spin") {
        process = Spawn("spin", RunSpin, 0);
    } else if Equals(arguments, "hello") {
        process = Spawn("hello", RunHello, 0);
    } else {
        WriteLine("Usage: run <anim|counter|spin|hello>");
        return;
    }

    if process == NO_PROCESS {
        WriteLine("There is no room for another process.");
        return;
    }

    Write("Started process ");
    WriteInteger(process);
    WriteCharacter('\n');
}

fn CommandKill(arguments: *i8) {
    let mut process: u32 = 0;
    let rest = ParseNumber(arguments, &mut process);

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: kill <pid>");
        return;
    }

    if process == 0 || process == current_process {
        WriteLine("The idle process and the shell cannot be stopped.");
    } else if !Kill(process) {
        WriteLine("There is no such process.");
    }
}

static mut first_path: [i8; 128];
static mut second_path: [i8; 128];

fn ReportFileError(error: u32) {
    if error != FILE_OK {
        WriteLine(FileErrorMessage(error));
    }
}

fn ParseOnePath(arguments: *i8, usage: *i8) -> bool {
    let rest = ParseWord(arguments, &mut first_path[0], LINE_LENGTH as u32);

    if rest == null || !AtEnd(rest) {
        WriteLine(usage);
        return false;
    }

    true
}

fn ParseTwoPaths(arguments: *i8, usage: *i8) -> bool {
    let mut rest = ParseWord(arguments, &mut first_path[0], LINE_LENGTH as u32);

    if rest != null {
        rest = ParseWord(rest, &mut second_path[0], LINE_LENGTH as u32);
    }

    if rest == null || !AtEnd(rest) {
        WriteLine(usage);
        return false;
    }

    true
}

#[include "std/file", "src/Lexer.zir", "src/Preprocessor.zir", "src/Parser.zir", "src/HIRLowerer.zir", "src/MIRLowerer.zir", "src/MIRPasses.zir",
    "src/LIRLowerer.zir", "src/LIRAllocator.zir", "src/ZodiacEmitter.zir", "src/Logger.zir" : *]

fn RunCompiler(argument: u32) {
#[if ZENITH_UNIFIED]
    if !BeginCompilerMemory() {
        WriteLine("The compiler is already running.");
        return;
    }
#[endif]
    let mut logger = Logger("zirconc".ToString());
    let input_path = String(&first_path[0] as *i8);
    let output_path = String(&second_path[0] as *i8);
    let read_result = _ReadFile(input_path);
    let source = match read_result {
        Result<String, IOError>::Ok(source) => source,
        Result<String, IOError>::Err(error) => {
            Logger::Log(input_path, "Failed to read file: " + error.ToString() + ".", LogSeverity::Error);
            ReleaseCompilerMemory();
            return;
        }
    };

    let mut lexer = Lexer();
    let mut preprocessor = Preprocessor();
    preprocessor.include_paths.PushBack(".".ToString());
    preprocessor.include_paths.PushBack("/include".ToString());
    preprocessor.defines.PushBack("ZODIAC".ToString());
    preprocessor.defines.PushBack("ZENITH".ToString());
    let tokens = preprocessor.Process(lexer.Lex(source, input_path), input_path);

    if Logger::HasError() {
        ReleaseCompilerMemory();
        return;
    }

    let mut parser = Parser();
    let ast_module = parser.Parse(tokens);

    if Logger::HasError() {
        ReleaseCompilerMemory();
        return;
    }

    let mut hir_lowerer = HIRLowerer(TargetInfo(4, 4, 4));
    let hir_module = hir_lowerer.Lower(ast_module);

    if Logger::HasError() || hir_module == null {
        ReleaseCompilerMemory();
        return;
    }

    let mut mir_lowerer = MIRLowerer(TargetInfo(4, 4, 4));
    let mir_module = mir_lowerer.Lower(hir_module);

    let mut passes = MIRPassManager(&mut mir_lowerer.context);
    passes.Add(MIRPassKind::ReorderBlocks);
    passes.Add(MIRPassKind::PromoteAllocas);
    passes.Run(mir_module);

    let mut lir_lowerer = LIRLowerer();
    let lir_module = lir_lowerer.Lower(mir_module);

    let mut allocator = LIRAllocator(&mut lir_lowerer.context);
    allocator.Allocate(lir_module);

    let mut emitter = ZodiacEmitter();
    let assembly = emitter.Emit(lir_module);

    if let Result<(), IOError>::Err(error) = _WriteFile(output_path, assembly) {
        Logger::Log(output_path, "Failed to write file: " + error.ToString() + ".", LogSeverity::Error);
        ReleaseCompilerMemory();
        return;
    }

    ReleaseCompilerMemory();
}

fn CommandCompile(arguments: *i8) {
    if !ParseTwoPaths(arguments, "Usage: zircon <input> <output>") {
        return;
    }

    let process = SpawnWithStack("zircon", RunCompiler, 0, COMPILER_STACK_SIZE);

    if process == NO_PROCESS {
        WriteLine("Cannot start the compiler: no process slot or stack memory.");
        return;
    }

    while processes[process as usize].state != ProcessState::Free && processes[process as usize].state != ProcessState::Crashed {
        Sleep(MILLISECONDS_PER_TICK);
    }

    if processes[process as usize].state == ProcessState::Crashed {
        ReleaseCompilerMemoryForProcess(process);
        Kill(process);
        WriteLine("Compiler process crashed.");
    }
}

fn WriteEntry(file: *FileEntry) {
    if IsDirectory(file) {
        Write(FileName(file));
        WriteLine("/");
    } else {
        WriteColumn(FileName(file), FILE_NAME_LENGTH);
        WriteInteger(file->size);
        WriteLine(" bytes");
    }
}

fn CommandList(arguments: *i8) {
    if !HasFileSystem() {
        ReportFileError(FILE_NO_FILE_SYSTEM);
        return;
    }

    let mut index = IndexOfId(current_directory);

    if !AtEnd(arguments) {
        if !ParseOnePath(arguments, "Usage: ls [path]") {
            return;
        }

        index = FindPath(&first_path[0] as *i8);
    }

    if index == NO_ENTRY {
        ReportFileError(FILE_NOT_FOUND);
        return;
    }

    if !IsDirectoryIndex(index) {
        WriteEntry(GetFile(index) as *FileEntry);
        return;
    }

    let directory = IdOfIndex(index);
    let count = FileCount();
    let mut i: u32 = 0;

    while i < count {
        let file = GetFile(i) as *FileEntry;

        if file->parent == directory {
            WriteEntry(file);
        }

        i += 1;
    }
}

fn CommandCat(arguments: *i8) {
    if !ParseOnePath(arguments, "Usage: cat <file>") {
        return;
    }

    if !HasFileSystem() {
        ReportFileError(FILE_NO_FILE_SYSTEM);
        return;
    }

    let file = FindFile(&first_path[0] as *i8);

    if file == null {
        ReportFileError(FILE_NOT_FOUND);
        return;
    }

    if IsDirectory(file) {
        ReportFileError(FILE_IS_DIRECTORY);
        return;
    }

    let mut buffer: [u8; CAT_BUFFER_SIZE];
    let mut offset: u32 = 0;

    loop {
        let count = ReadFile(file, offset, &mut buffer[0], CAT_BUFFER_SIZE as u32);

        if count == 0 {
            break;
        }

        let mut i: u32 = 0;

        while i < count {
            WriteCharacter(buffer[i as usize] as i8);
            i += 1;
        }

        offset += count;
    }
}

fn CommandWrite(arguments: *i8) {
    let rest = ParseWord(arguments, &mut first_path[0], LINE_LENGTH as u32);

    if rest == null {
        WriteLine("Usage: write <file> <text>");
        return;
    }

    let text = SkipSpaces(rest);
    let length = StringLength(text);
    let data = Allocate(length + 1);

    if data == null {
        ReportFileError(FILE_NO_MEMORY);
        return;
    }

    let mut i: u32 = 0;

    while i < length {
        data[i as usize] = *(text + i as usize) as u8;
        i += 1;
    }

    data[length as usize] = '\n' as u8;
    let error = WriteFile(&first_path[0] as *i8, data as *u8, length + 1);
    Free(data);
    ReportFileError(error);
}

fn CommandMakeDirectory(arguments: *i8) {
    if ParseOnePath(arguments, "Usage: mkdir <path>") {
        ReportFileError(MakeDirectory(&first_path[0] as *i8));
    }
}

fn CommandRemove(arguments: *i8) {
    if ParseOnePath(arguments, "Usage: rm <path>") {
        ReportFileError(RemovePath(&first_path[0] as *i8));
    }
}

fn CommandChangeDirectory(arguments: *i8) {
    if AtEnd(arguments) {
        ReportFileError(ChangeDirectory("/"));
    } else if ParseOnePath(arguments, "Usage: cd [path]") {
        ReportFileError(ChangeDirectory(&first_path[0] as *i8));
    }
}

fn WriteDirectoryPath(id: u32) {
    let index = IndexOfId(id);

    if id == ROOT_DIRECTORY || index == NO_ENTRY {
        return;
    }

    let file = GetFile(index) as *FileEntry;
    WriteDirectoryPath(file->parent);
    WriteCharacter('/');
    Write(FileName(file));
}

fn CommandPrintDirectory() {
    if current_directory == ROOT_DIRECTORY {
        WriteCharacter('/');
    } else {
        WriteDirectoryPath(current_directory);
    }

    WriteCharacter('\n');
}

fn CommandCopy(arguments: *i8) {
    if ParseTwoPaths(arguments, "Usage: cp <source> <target>") {
        ReportFileError(CopyFile(&first_path[0] as *i8, &second_path[0] as *i8));
    }
}

fn CommandMove(arguments: *i8) {
    if ParseTwoPaths(arguments, "Usage: mv <source> <target>") {
        ReportFileError(MovePath(&first_path[0] as *i8, &second_path[0] as *i8));
    }
}

fn CommandDiskFree() {
    if !HasFileSystem() {
        ReportFileError(FILE_NO_FILE_SYSTEM);
        return;
    }

    let (total, used) = (FileSystemBlocks(), UsedBlockCount());
    Write("Blocks:  ");
    WriteInteger(used);
    Write(" of ");
    WriteInteger(total);
    Write(" used, ");
    WriteInteger(BLOCK_SIZE);
    WriteLine(" bytes each");
    Write("Free:    ");
    WriteInteger((total - used) * BLOCK_SIZE);
    WriteLine(" bytes");
    Write("Entries: ");
    WriteInteger(FileCount());
    Write(" of ");
    WriteInteger(MAX_FILES);
    Write(", the table is in block ");
    WriteInteger(current_table);
    Write(" at ");
    WriteInteger(current_offset);
    WriteCharacter('\n');
}

fn CommandFormat() {
    let error = FormatFileSystem(DEFAULT_BLOCKS);

    if error != FILE_OK {
        WriteLine(FileErrorMessage(error));
    }
}

fn RunCommand(line: *i8) {
    let mut arguments = line;

    if AtEnd(line) {
    } else if ParseCommand(line, "help", &mut arguments) {
        CommandHelp();
    } else if ParseCommand(line, "echo", &mut arguments) {
        WriteLine(arguments);
    } else if ParseCommand(line, "uptime", &mut arguments) {
        WriteInteger(GetTime());
        Write(" ms, ");
        WriteInteger(ticks);
        WriteLine(" timer ticks");
    } else if ParseCommand(line, "clear", &mut arguments) {
        Write("\x1B[2J\x1B[H");
    } else if ParseCommand(line, "info", &mut arguments) {
        CommandInfo();
    } else if ParseCommand(line, "peek", &mut arguments) {
        CommandPeek(arguments);
    } else if ParseCommand(line, "poke", &mut arguments) {
        CommandPoke(arguments);
    } else if ParseCommand(line, "dump", &mut arguments) {
        CommandDump(arguments);
    } else if ParseCommand(line, "heap", &mut arguments) {
        CommandHeap();
    } else if ParseCommand(line, "alloc", &mut arguments) {
        CommandAlloc(arguments);
    } else if ParseCommand(line, "free", &mut arguments) {
        CommandFree(arguments);
    } else if ParseCommand(line, "anim", &mut arguments) {
        CommandAnimation(arguments);
    } else if ParseCommand(line, "ps", &mut arguments) {
        CommandProcesses();
    } else if ParseCommand(line, "run", &mut arguments) {
        CommandRun(arguments);
    } else if ParseCommand(line, "kill", &mut arguments) {
        CommandKill(arguments);
    } else if ParseCommand(line, "ls", &mut arguments) {
        CommandList(arguments);
    } else if ParseCommand(line, "cat", &mut arguments) {
        CommandCat(arguments);
    } else if ParseCommand(line, "write", &mut arguments) {
        CommandWrite(arguments);
    } else if ParseCommand(line, "rm", &mut arguments) {
        CommandRemove(arguments);
    } else if ParseCommand(line, "mkdir", &mut arguments) {
        CommandMakeDirectory(arguments);
    } else if ParseCommand(line, "cd", &mut arguments) {
        CommandChangeDirectory(arguments);
    } else if ParseCommand(line, "pwd", &mut arguments) {
        CommandPrintDirectory();
    } else if ParseCommand(line, "cp", &mut arguments) {
        CommandCopy(arguments);
    } else if ParseCommand(line, "mv", &mut arguments) {
        CommandMove(arguments);
    } else if ParseCommand(line, "df", &mut arguments) {
        CommandDiskFree();
    } else if ParseCommand(line, "zircon", &mut arguments) {
        CommandCompile(arguments);
    } else if ParseCommand(line, "format", &mut arguments) {
        CommandFormat();
    } else {
        Write("Unknown command: ");
        WriteLine(line);
    }
}

fn RunShell(argument: u32) {
    let mut line: [i8; LINE_LENGTH];

    loop {
        Write("zenith> ");
        ReadLine(&mut line[0], LINE_LENGTH);
        AddHistory(&line[0] as *i8);
        RunCommand(&line[0] as *i8);
    }
}
