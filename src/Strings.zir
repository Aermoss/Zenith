fn Equals(mut left: *i8, mut right: *i8) -> bool {
    while *left == *right {
        if *left == '\0' {
            return true;
        }

        left += 1;
        right += 1;
    }

    false
}

fn SkipSpaces(mut text: *i8) -> *i8 {
    while *text == ' ' {
        text += 1;
    }

    text
}

fn AtEnd(text: *i8) -> bool {
    *SkipSpaces(text) == '\0'
}

fn ParseCommand(mut line: *i8, mut name: *i8, arguments: *mut *i8) -> bool {
    while *name != '\0' {
        if *line != *name {
            return false;
        }

        line += 1;
        name += 1;
    }

    if *line != '\0' && *line != ' ' {
        return false;
    }

    *arguments = SkipSpaces(line);
    true
}

fn ParseNumber(text: *i8, value: *mut u32) -> *i8 {
    let mut current = SkipSpaces(text);
    let mut base: u32 = 10;
    let mut result: u32 = 0;

    if *current == '0' && (*(current + 1) == 'x' || *(current + 1) == 'X') {
        base = 16;
        current += 2;
    }

    let start = current;

    loop {
        let character = *current;
        let mut digit: u32 = 16;

        if character >= '0' && character <= '9' {
            digit = (character - '0') as u32;
        } else if character >= 'a' && character <= 'f' {
            digit = (character - 'a') as u32 + 10;
        } else if character >= 'A' && character <= 'F' {
            digit = (character - 'A') as u32 + 10;
        }

        if digit >= base {
            break;
        }

        result = result * base + digit;
        current += 1;
    }

    if current == start || (*current != '\0' && *current != ' ') {
        return null;
    }

    *value = result;
    current
}
