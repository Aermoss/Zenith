#[include "src/Devices.zir", "src/Console.zir", "src/Process.zir" : *]

const COUNTER_INTERVAL: u32 = 10;

static mut spin_count: u32 = 0;

fn RunCounter(argument: u32) {
    let mut count: u32 = 0;

    loop {
        SetLEDs(((count & 0x3F) ^ 0x3F) as i8);
        count += 1;
        Sleep(COUNTER_INTERVAL);
    }
}

fn RunHello(argument: u32) {
    Write("Hello from process ");
    WriteInteger(current_process);
    WriteLine(".");
}

fn RunSpin(argument: u32) {
    loop {
        spin_count += 1;
    }
}
