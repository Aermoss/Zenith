#[include "src/Devices.zir", "src/Process.zir" : *]

const ANIMATION_MODES: u32 = 5;
const ANIMATION_INTERVAL: u32 = 10;

static mut animation_mode: u32 = 0;
static mut animation_brightness: u8 = 64;
static mut button_was_pressed: bool = false;

static mut fade_state: u32 = 0;
static mut fade_red: u8 = 255;
static mut fade_green: u8 = 0;
static mut fade_blue: u8 = 0;

fn StepFade() {
    match fade_state {
        0 => {
            fade_green += 5;

            if fade_green >= 255 {
                fade_state = 1;
                fade_green = 255;
            }
        },
        1 => {
            if fade_red <= 5 {
                fade_state = 2;
                fade_red = 0;
            } else {
                fade_red -= 5;
            }
        },
        2 => {
            fade_blue += 5;

            if fade_blue >= 255 {
                fade_state = 3;
                fade_blue = 255;
            }
        },
        3 => {
            if fade_green <= 5 {
                fade_state = 4;
                fade_green = 0;
            } else {
                fade_green -= 5;
            }
        },
        4 => {
            fade_red += 5;

            if fade_red >= 255 {
                fade_state = 5;
                fade_red = 255;
            }
        },
        _ => {
            if fade_blue <= 5 {
                fade_state = 0;
                fade_blue = 0;
            } else {
                fade_blue -= 5;
            }
        }
    }
}

fn StepAnimation() {
    let pressed = ButtonPressed();

    if pressed && !button_was_pressed {
        animation_mode = (animation_mode + 1) % ANIMATION_MODES;
    }

    button_was_pressed = pressed;

    match animation_mode {
        0 => {
            StepFade();
            SetWS2812(fade_red, fade_green, fade_blue, animation_brightness);
        },
        1 => {
            SetWS2812(255, 0, 0, animation_brightness);
        },
        2 => {
            SetWS2812(0, 255, 0, animation_brightness);
        },
        3 => {
            SetWS2812(0, 0, 255, animation_brightness);
        },
        _ => {
            SetWS2812(0, 0, 0, animation_brightness);
        }
    }
}

fn RunAnimation(argument: u32) {
    loop {
        StepAnimation();
        Sleep(ANIMATION_INTERVAL);
    }
}
