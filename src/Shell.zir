#[include "src/Devices.zir", "src/Console.zir", "src/Strings.zir", "src/Memory.zir", "src/Interrupts.zir", "src/Process.zir", "src/Animation.zir", "src/Programs.zir" : *]

const LINE_LENGTH: usize = 128;
const DUMP_LENGTH: u32 = 64;

fn CommandHelp() {
    WriteLine("help                     show the commands");
    WriteLine("echo <text>              print the text");
    WriteLine("uptime                   show the time since boot");
    WriteLine("clear                    clear the screen");
    WriteLine("info                     show the memory map");
    WriteLine("peek <address>           read a word");
    WriteLine("poke <address> <value>   write a word");
    WriteLine("dump <address> [length]  show memory as bytes");
    WriteLine("heap                     show how much of the heap is used");
    WriteLine("alloc <size>             allocate memory from the heap");
    WriteLine("free <address>           free memory allocated with alloc");
    WriteLine("anim <mode> [brightness] set the RGB LED animation, 0 to 4");
    WriteLine("ps                       show the processes");
    WriteLine("run <program>            start anim, counter, spin or hello as a process");
    WriteLine("kill <pid>               stop a process");
}

fn WriteRange(name: *i8, start: u32, end: u32) {
    Write(name);
    WriteHexadecimal(start);
    Write(" - ");
    WriteHexadecimal(end);
    WriteCharacter('\n');
}

fn CommandInfo() {
    Write("Clock:   ");
    WriteInteger(CLK_FREQ / 1000000);
    WriteLine(" MHz");
    WriteRange("Stacks:  ", STACKS_START, STACKS_END);
    WriteRange("Kernel:  ", SDRAM_START, kernel_end);
    WriteRange("Heap:    ", heap_start, heap_end);
    WriteRange("Flash:   ", FLASH_START, FLASH_END);
}

fn IsWordAddress(address: u32) -> bool {
    if (address & 3) != 0 {
        WriteLine("The address must be a multiple of 4.");
        return false;
    }

    true
}

fn CommandPeek(arguments: *i8) {
    let mut address: u32 = 0;
    let rest = ParseNumber(arguments, &mut address);

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: peek <address>");
        return;
    }

    if !IsWordAddress(address) {
        return;
    }

    WriteHexadecimal(address);
    Write(": ");
    WriteHexadecimal(*(address as *u32));
    WriteCharacter('\n');
}

fn CommandPoke(arguments: *i8) {
    let mut address: u32 = 0;
    let mut value: u32 = 0;
    let mut rest = ParseNumber(arguments, &mut address);

    if rest != null {
        rest = ParseNumber(rest, &mut value);
    }

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: poke <address> <value>");
        return;
    }

    if !IsWordAddress(address) {
        return;
    }

    *(address as *mut u32) = value;
}

fn CommandDump(arguments: *i8) {
    let mut address: u32 = 0;
    let mut length = DUMP_LENGTH;
    let mut rest = ParseNumber(arguments, &mut address);

    if rest != null && !AtEnd(rest) {
        rest = ParseNumber(rest, &mut length);
    }

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: dump <address> [length]");
        return;
    }

    let end = address + length;
    let mut line = address;

    while line < end {
        WriteHexadecimalDigits(line, 8);
        Write(": ");
        let mut i: u32 = 0;

        while i < 16 {
            if line + i < end {
                WriteHexadecimalDigits(*((line + i) as *u8) as u32, 2);
                WriteCharacter(' ');
            } else {
                Write("   ");
            }

            i += 1;
        }

        Write(" ");
        i = 0;

        while i < 16 && line + i < end {
            let character = *((line + i) as *i8);

            if character >= ' ' && character <= '~' {
                WriteCharacter(character);
            } else {
                WriteCharacter('.');
            }

            i += 1;
        }

        WriteCharacter('\n');
        line += 16;
    }
}

fn CommandHeap() {
    let mut used: u32 = 0;
    let mut free: u32 = 0;
    let mut largest_free: u32 = 0;
    GetHeapStatistics(&mut used, &mut free, &mut largest_free);

    WriteRange("Heap:    ", heap_start, heap_end);
    Write("Used:    ");
    WriteInteger(used);
    WriteLine(" bytes");
    Write("Free:    ");
    WriteInteger(free);
    Write(" bytes, the largest block is ");
    WriteInteger(largest_free);
    WriteLine(" bytes");
}

fn CommandAlloc(arguments: *i8) {
    let mut size: u32 = 0;
    let rest = ParseNumber(arguments, &mut size);

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: alloc <size>");
        return;
    }

    let pointer = Allocate(size);

    if pointer == null {
        WriteLine("Not enough memory.");
        return;
    }

    Write("Allocated ");
    WriteInteger(size);
    Write(" bytes at ");
    WriteHexadecimal(pointer as u32);
    WriteCharacter('\n');
}

fn CommandFree(arguments: *i8) {
    let mut address: u32 = 0;
    let rest = ParseNumber(arguments, &mut address);

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: free <address>");
        return;
    }

    if !Free(address as *mut u8) {
        WriteLine("There is no allocation at that address.");
    }
}

fn CommandAnimation(arguments: *i8) {
    let mut mode: u32 = 0;
    let mut brightness = animation_brightness as u32;
    let mut rest = ParseNumber(arguments, &mut mode);

    if rest != null && !AtEnd(rest) {
        rest = ParseNumber(rest, &mut brightness);
    }

    if rest == null || !AtEnd(rest) || mode >= ANIMATION_MODES || brightness > 255 {
        WriteLine("Usage: anim <mode> [brightness] [speed]");
        return;
    }

    animation_mode = mode;
    animation_brightness = brightness as u8;
}

fn DigitCount(mut value: u32) -> u32 {
    let mut digits: u32 = 1;

    while value >= 10 {
        value /= 10;
        digits += 1;
    }

    digits
}

fn WriteSpaces(count: u32) {
    let mut i: u32 = 0;

    while i < count {
        WriteCharacter(' ');
        i += 1;
    }
}

fn WriteColumn(mut text: *i8, width: u32) {
    let mut length: u32 = 0;

    while *text != '\0' {
        WriteCharacter(*text);
        text += 1;
        length += 1;
    }

    WriteSpaces(width - length);
}

fn WriteIntegerColumn(value: u32, width: u32) {
    WriteInteger(value);
    WriteSpaces(width - DigitCount(value));
}

fn StateName(id: u32) -> *i8 {
    match processes[id as usize].state {
        ProcessState::Free => "free",
        ProcessState::Ready => if id == current_process { "running" } else { "ready" },
        ProcessState::Sleeping => "sleeping",
        ProcessState::Waiting => "waiting",
        ProcessState::Crashed => "crashed"
    }
}

fn CommandProcesses() {
    WriteLine("PID  STATE     TICKS     STACK             NAME");
    let mut id: u32 = 0;

    while id < MAX_PROCESSES {
        let process = &processes[id as usize];

        if process.state != ProcessState::Free {
            WriteIntegerColumn(id, 5);
            WriteColumn(StateName(id), 10);
            WriteIntegerColumn(process.ticks, 10);
            WriteColumn(if IsStackInBRAM(id) { "bram" } else { "sdram" }, 6);
            WriteHexadecimal(process.stack_bottom);
            WriteSpaces(2);
            WriteLine(process.name);
        }

        id += 1;
    }
}

fn CommandRun(arguments: *i8) {
    let mut process = NO_PROCESS;

    if Equals(arguments, "anim") {
        process = Spawn("anim", RunAnimation, 0);
    } else if Equals(arguments, "counter") {
        process = Spawn("counter", RunCounter, 0);
    } else if Equals(arguments, "spin") {
        process = Spawn("spin", RunSpin, 0);
    } else if Equals(arguments, "hello") {
        process = Spawn("hello", RunHello, 0);
    } else {
        WriteLine("Usage: run <anim|counter|spin|hello>");
        return;
    }

    if process == NO_PROCESS {
        WriteLine("There is no room for another process.");
        return;
    }

    Write("Started process ");
    WriteInteger(process);
    WriteCharacter('\n');
}

fn CommandKill(arguments: *i8) {
    let mut process: u32 = 0;
    let rest = ParseNumber(arguments, &mut process);

    if rest == null || !AtEnd(rest) {
        WriteLine("Usage: kill <pid>");
        return;
    }

    if process == 0 || process == current_process {
        WriteLine("The idle process and the shell cannot be stopped.");
    } else if !Kill(process) {
        WriteLine("There is no such process.");
    }
}

fn RunCommand(line: *i8) {
    let mut arguments = line;

    if AtEnd(line) {
    } else if ParseCommand(line, "help", &mut arguments) {
        CommandHelp();
    } else if ParseCommand(line, "echo", &mut arguments) {
        WriteLine(arguments);
    } else if ParseCommand(line, "uptime", &mut arguments) {
        WriteInteger(GetTime());
        Write(" ms, ");
        WriteInteger(ticks);
        WriteLine(" timer ticks");
    } else if ParseCommand(line, "clear", &mut arguments) {
        Write("\x1B[2J\x1B[H");
    } else if ParseCommand(line, "info", &mut arguments) {
        CommandInfo();
    } else if ParseCommand(line, "peek", &mut arguments) {
        CommandPeek(arguments);
    } else if ParseCommand(line, "poke", &mut arguments) {
        CommandPoke(arguments);
    } else if ParseCommand(line, "dump", &mut arguments) {
        CommandDump(arguments);
    } else if ParseCommand(line, "heap", &mut arguments) {
        CommandHeap();
    } else if ParseCommand(line, "alloc", &mut arguments) {
        CommandAlloc(arguments);
    } else if ParseCommand(line, "free", &mut arguments) {
        CommandFree(arguments);
    } else if ParseCommand(line, "anim", &mut arguments) {
        CommandAnimation(arguments);
    } else if ParseCommand(line, "ps", &mut arguments) {
        CommandProcesses();
    } else if ParseCommand(line, "run", &mut arguments) {
        CommandRun(arguments);
    } else if ParseCommand(line, "kill", &mut arguments) {
        CommandKill(arguments);
    } else {
        Write("Unknown command: ");
        WriteLine(line);
    }
}

fn RunShell(argument: u32) {
    let mut line: [i8; LINE_LENGTH];

    loop {
        Write("zenith> ");
        ReadLine(&mut line[0], LINE_LENGTH);
        AddHistory(&line[0] as *i8);
        RunCommand(&line[0] as *i8);
    }
}
