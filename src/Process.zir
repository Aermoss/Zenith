#[include "src/Devices.zir", "src/Trap.zir", "src/Memory.zir", "src/Paging.zir", "src/Handles.zir" : *]

type ProcessEntry = fn(u32);

const TICK_RATE: u32 = 100;
const MILLISECONDS_PER_TICK: u32 = 1000 / TICK_RATE;

const MAX_PROCESSES: u32 = 16;
const NO_PROCESS: u32 = 0xFFFFFFFF;

const STACK_SIZE: u32 = 1024;
const BRAM_STACKS: u32 = 12;
const STACKS_END: u32 = 0x00004000;
const STACKS_START: u32 = STACKS_END - BRAM_STACKS * STACK_SIZE;
const STACK_CANARY: u32 = 0x5AFE57AC;
const KERNEL_STACK_SIZE: u32 = 8192;

const STATUS_PREVIOUS_ENABLE: u32 = 2;
const STATUS_PREVIOUS_USER: u32 = 4;

struct Frame {
    pub epc: u32,
    pub ra: u32, pub sp: u32, pub gp: u32, pub tp: u32, pub fp: u32,
    pub s1: u32, pub s2: u32, pub s3: u32, pub s4: u32, pub s5: u32, pub s6: u32, pub s7: u32, pub s8: u32, pub s9: u32, pub s10: u32, pub s11: u32,
    pub t0: u32, pub t1: u32, pub t2: u32, pub t3: u32, pub t4: u32, pub t5: u32, pub t6: u32,
    pub a0: u32, pub a1: u32, pub a2: u32, pub a3: u32, pub a4: u32, pub a5: u32, pub a6: u32, pub a7: u32,
    pub status: u32
}

enum ProcessState: u32 {
    Free, Ready, Sleeping, Waiting, Joining, Crashed, Loading
}

struct Process {
    pub state: ProcessState,
    pub frame: *mut Frame,
    pub wake_tick: u32,
    pub ticks: u32,
    pub name: *i8,
    pub label: [i8; 32],
    pub arguments: [i8; 128],
    pub image: *mut u8,
    pub stack_bottom: u32,
    pub stack_top: u32,
    pub child: u32,
    pub child_status: *mut i32,
    pub page_table: u32,
    pub heap_hint: u32
}

static mut processes: [Process; 16];
static mut current_process: u32 = 0;
static mut ticks: u32 = 0;

fn IsStackInBRAM(id: u32) -> bool {
    processes[id as usize].stack_bottom < STACKS_END
}

fn AllocateStack(id: u32, size: u32) -> u32 {
    if id < BRAM_STACKS && size == STACK_SIZE {
        STACKS_END - (id + 1) * STACK_SIZE
    } else {
        Allocate(size) as u32
    }
}

fn ReleaseStack(id: u32) {
    if !IsStackInBRAM(id) {
        Free(processes[id as usize].stack_bottom as *mut u8);
    }

    if processes[id as usize].image != null {
        Free(processes[id as usize].image);
        processes[id as usize].image = null;
    }
}

fn ReleaseProcess(id: u32, save: bool) {
    CloseProcessFiles(id, save);
    FreeProcessAllocations(id);
    ReleaseStack(id);

    if processes[id as usize].page_table != 0 {
        processes[id as usize].page_table = 0;
        FlushTLB(1);
    }

    processes[id as usize].state = ProcessState::Free;
}

fn ActivateProcess(id: u32) {
    let process = &processes[id as usize];

    if process.page_table != 0 {
        SetAddressSpace(process.page_table | PTBASE_VALID, id);
    } else {
        SetAddressSpace(0, id);
    }
}

fn IsUserProcess(id: u32) -> bool {
    processes[id as usize].page_table != 0
}

fn AllocateUserMemory(id: u32, size: u32) -> u32 {
    let process = &mut processes[id as usize];

    if process.page_table == 0 {
        return AllocateForProcess(size, id) as u32;
    }

    if size == 0 || size > USER_HEAP_END - USER_HEAP_START {
        return 0;
    }

    let pages = (size + PAGE_MASK) / PAGE_SIZE;
    let address = FindFreeRange(process.page_table, process.heap_hint, pages);

    if address == 0 || !MapRange(id, process.page_table, address, size, PTE_WRITE) {
        return 0;
    }

    process.heap_hint = address + (pages + 1) * PAGE_SIZE;
    address
}

fn FreeUserMemory(id: u32, address: u32) -> bool {
    let root = processes[id as usize].page_table;

    if root == 0 {
        return FreeForProcess(address as *mut u8, id);
    }

    let pages = AllocationPages(root, address);

    if pages == 0 {
        return false;
    }

    UnmapPages(id, root, address, pages);
    true
}

fn SetStack(id: u32, bottom: u32, size: u32) {
    let process = &mut processes[id as usize];
    process.stack_bottom = bottom;
    process.stack_top = bottom + size;
    *(bottom as *mut u32) = STACK_CANARY;
}

fn InitializeProcesses() {
    current_process = 0;
    processes[0].state = ProcessState::Ready;
    processes[0].name = "idle";
    SetStack(0, AllocateStack(0, STACK_SIZE), STACK_SIZE);
}

fn Spawn(name: *i8, entry: ProcessEntry, argument: u32) -> u32 {
    SpawnWithStack(name, entry, argument, STACK_SIZE)
}

fn SpawnWithStack(name: *i8, entry: ProcessEntry, argument: u32, mut stack_size: u32) -> u32 {
    if stack_size < sizeof(Frame) as u32 + 8 || stack_size > 0xFFFFFFF8 {
        return NO_PROCESS;
    }

    stack_size = (stack_size + 7) & !7u32;
    let interrupts = DisableInterrupts();
    let mut id: u32 = 1;

    while id < MAX_PROCESSES && processes[id as usize].state != ProcessState::Free && processes[id as usize].state != ProcessState::Crashed {
        id += 1;
    }

    if id == MAX_PROCESSES {
        RestoreInterrupts(interrupts);
        return NO_PROCESS;
    }

    if processes[id as usize].state == ProcessState::Crashed {
        ReleaseProcess(id, false);
    }

    let stack = AllocateStack(id, stack_size);

    if stack == 0 {
        RestoreInterrupts(interrupts);
        return NO_PROCESS;
    }

    SetStack(id, stack, stack_size);
    let frame = (stack + stack_size - sizeof(Frame) as u32) as *mut Frame;
    let words = frame as *mut u32;

    for i in 0..sizeof(Frame) / 4 {
        words[i] = 0;
    }

    frame->epc = entry as *void as u32;
    frame->ra = ExitProcess as *void as u32;
    frame->sp = stack + stack_size;
    frame->a0 = argument;
    frame->status = STATUS_PREVIOUS_ENABLE;

    let process = &mut processes[id as usize];
    process.frame = frame;
    process.ticks = 0;
    process.name = name;
    process.image = null;
    process.child = NO_PROCESS;
    process.child_status = null;
    process.page_table = 0;
    process.heap_hint = USER_HEAP_START;
    process.state = ProcessState::Ready;
    RestoreInterrupts(interrupts);
    id
}

fn SpawnUser(name: *i8, arguments: *i8, entry: u32) -> u32 {
    let interrupts = DisableInterrupts();
    let id = SpawnWithStack(name, entry as *void as ProcessEntry, 0, KERNEL_STACK_SIZE);

    if id != NO_PROCESS {
        let process = &mut processes[id as usize];
        let mut i: usize = 0;

        while i < 31 && name[i] != '\0' {
            process.label[i] = name[i];
            i += 1;
        }

        process.label[i] = '\0';
        process.name = &process.label[0] as *i8;
        let mut j: usize = 0;

        if arguments != null {
            while j < 127 && arguments[j] != '\0' {
                process.arguments[j] = arguments[j];
                j += 1;
            }
        }

        process.arguments[j] = '\0';
        process.frame->ra = 0;
        process.frame->sp = USER_STACK_TOP;
        process.frame->status = STATUS_PREVIOUS_ENABLE | STATUS_PREVIOUS_USER;
        process.state = ProcessState::Loading;
    }

    RestoreInterrupts(interrupts);
    id
}

fn GetCommandLine(buffer: *mut i8, capacity: usize) -> usize {
    if buffer == null || capacity == 0 {
        return 0;
    }

    let source = &processes[current_process as usize].arguments[0] as *i8;
    let mut i: usize = 0;

    while i + 1 < capacity && source[i] != '\0' {
        buffer[i] = source[i];
        i += 1;
    }

    buffer[i] = '\0';
    i
}

fn WakeJoiningProcesses(child: u32, error: u32, status: i32) {
    let mut id: u32 = 1;

    while id < MAX_PROCESSES {
        let process = &mut processes[id as usize];

        if process.state == ProcessState::Joining && process.child == child {
            if error == FILE_OK && process.child_status != null {
                WriteProcessWord(process.page_table, process.child_status as u32, status as u32);
            }

            process.frame->a0 = error;
            process.child = NO_PROCESS;
            process.child_status = null;
            process.state = ProcessState::Ready;
        }

        id += 1;
    }
}

fn ExitProcess() {
    DisableInterrupts();
    WakeJoiningProcesses(current_process, FILE_OK, 0);
    ReleaseProcess(current_process, true);
    Yield();
}

fn Kill(id: u32) -> bool {
    if id == 0 || id == current_process || id >= MAX_PROCESSES {
        return false;
    }

    let interrupts = DisableInterrupts();
    let killed = processes[id as usize].state != ProcessState::Free;

    if killed {
        WakeJoiningProcesses(id, FILE_KILLED, 0);
        ReleaseProcess(id, false);
    }

    RestoreInterrupts(interrupts);
    killed
}

fn Sleep(milliseconds: u32) {
    let interrupts = DisableInterrupts();
    let process = &mut processes[current_process as usize];
    process.wake_tick = ticks + (milliseconds + MILLISECONDS_PER_TICK - 1) / MILLISECONDS_PER_TICK;
    process.state = ProcessState::Sleeping;
    Yield();
    RestoreInterrupts(interrupts);
}

fn WaitForInput() {
    processes[current_process as usize].state = ProcessState::Waiting;
    Yield();
}

fn WakeSleepingProcesses() {
    let mut id: u32 = 1;

    while id < MAX_PROCESSES {
        let process = &mut processes[id as usize];

        if process.state == ProcessState::Sleeping && ((ticks - process.wake_tick) as i32) >= 0 {
            process.state = ProcessState::Ready;
        }

        id += 1;
    }
}

fn WakeWaitingProcesses() -> u32 {
    let mut woken = NO_PROCESS;
    let mut id: u32 = 1;

    while id < MAX_PROCESSES {
        let process = &mut processes[id as usize];

        if process.state == ProcessState::Waiting {
            process.state = ProcessState::Ready;

            if woken == NO_PROCESS {
                woken = id;
            }
        }

        id += 1;
    }

    woken
}

fn SaveContext(frame: *mut Frame) {
    let process = &mut processes[current_process as usize];
    process.frame = frame;

    if process.state != ProcessState::Free && process.state != ProcessState::Crashed && *(process.stack_bottom as *u32) != STACK_CANARY {
        process.state = ProcessState::Crashed;
        WakeJoiningProcesses(current_process, FILE_CRASHED, 0);
    }
}

fn SwitchTo(frame: *mut Frame, id: u32) -> *mut Frame {
    SaveContext(frame);
    current_process = id;
    ActivateProcess(id);
    processes[id as usize].frame
}

@nomangle
fn Schedule(frame: *mut Frame) -> *mut Frame {
    SaveContext(frame);
    let mut id = current_process;
    let mut i: u32 = 0;

    while i < MAX_PROCESSES {
        id = (id + 1) % MAX_PROCESSES;

        if id != 0 && processes[id as usize].state == ProcessState::Ready {
            current_process = id;
            ActivateProcess(id);
            return processes[id as usize].frame;
        }

        i += 1;
    }

    current_process = 0;
    ActivateProcess(0);
    processes[0].frame
}
