const CLK_FREQ: u32 = 54000000;

const UART_DATA: u32 = 0xFFFF;
const UART_STATUS: u32 = 0xFFFC;
const UART_DIVISOR: u32 = 0xFFF8;

const BUTTON: u32 = 0xFFF4;
const WS2812: u32 = 0xFFE0;
const LEDS: u32 = 0xFFF0;

const MS_COUNTER: u32 = 0xFFEC;
const CYCLE_COUNTER: u32 = 0xFFE8;
const INSTRUCTION_COUNTER: u32 = 0xFFE4;

fn SetBaudRate(baud: u32) {
    *(UART_DIVISOR as *mut u32) = CLK_FREQ / baud;
}

fn SetLEDs(leds: i8) {
    *(LEDS as *mut i8) = leds;
}

fn SetWS2812(_r: u8, _g: u8, _b: u8, brightness: u8) {
    let (mut r, mut g, mut b) = (_r as u32, _g as u32, _b as u32);

    if brightness < 255 {
        r = (r * brightness as u32) / 255;
        g = (g * brightness as u32) / 255;
        b = (b * brightness as u32) / 255;
    }

    *(WS2812 as *mut u32) = (g << 16) | (r << 8) | b;
}

fn ButtonPressed() -> bool {
    (*(BUTTON as *u32) & 1) == 0
}

fn GetTime() -> u32 {
    *(MS_COUNTER as *u32)
}

fn GetCycles() -> u32 {
    *(CYCLE_COUNTER as *u32)
}

fn GetInstructions() -> u32 {
    *(INSTRUCTION_COUNTER as *u32)
}
